{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miilo.dev/protocol/v0.1/action-result.schema.json",
  "title": "Miilo Action Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "providerId", "actionId", "status", "recordedAt"],
  "properties": {
    "protocolVersion": {"const": "0.1"},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 200},
    "providerId": {"type": "string", "minLength": 1, "maxLength": 200},
    "actionId": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {"enum": ["accepted", "completed", "rejected", "failed", "conflict"]},
    "recordedAt": {"type": "string", "format": "date-time"},
    "providerState": {"type": "string", "maxLength": 160},
    "message": {"type": "string", "maxLength": 1000},
    "nativeUrl": {"type": "string", "format": "uri"},
    "result": {"type": "object"}
  }
}
