{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Miilo launcher chat request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestId",
    "text"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "focus": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workKey",
            "revisionKey"
          ],
          "properties": {
            "workKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "revisionKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "history": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "text"
        ],
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    }
  }
}
