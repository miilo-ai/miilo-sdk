{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miilo.dev/protocol/v0.1/observatory-snapshot.schema.json",
  "title": "Miilo Observatory Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "snapshotId", "observedAt", "cursor", "providers", "workItems", "actors", "attempts", "artifacts", "evidence", "attention"],
  "properties": {
    "protocolVersion": {"const": "0.1"},
    "snapshotId": {"$ref": "#/$defs/id"},
    "observedAt": {"$ref": "#/$defs/timestamp"},
    "cursor": {"type": "string", "minLength": 1, "maxLength": 512},
    "providers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provider"}},
    "workItems": {"type": "array", "items": {"$ref": "#/$defs/workItem"}},
    "actors": {"type": "array", "items": {"$ref": "#/$defs/actor"}},
    "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "attention": {"type": "array", "items": {"$ref": "#/$defs/attentionItem"}},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "timestamp": {"type": "string", "format": "date-time"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["provider", "workspace", "initiative", "task", "attempt", "actor", "artifact", "evidence", "attention"]},
        "id": {"$ref": "#/$defs/id"}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observe", "control", "features"],
      "properties": {
        "observe": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "control": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "features": {"type": "object", "additionalProperties": {"type": "boolean"}}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "health", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "kind": {"enum": ["agent_harness", "automation_factory", "ci_cd", "research", "custom"]},
        "health": {"$ref": "#/$defs/health"},
        "nativeUrl": {"type": "string", "format": "uri"},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "lifecycle": {"enum": ["queued", "active", "waiting", "complete", "failed", "cancelled"]},
    "phase": {"enum": ["planning", "implementing", "verifying", "reviewing", "promoting", "unknown"]},
    "attentionLevel": {"enum": ["none", "informational", "decision", "approval", "intervention"]},
    "health": {"enum": ["healthy", "delayed", "stale", "degraded", "unreachable"]},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{
        "if": {"properties": {"risk": {"enum": ["bounded", "privileged", "destructive"]}}, "required": ["risk"]},
        "then": {"properties": {"confirmation": {"enum": ["explicit", "strong"]}}}
      }],
      "required": ["id", "label", "risk", "confirmation", "requiredScopes", "available", "idempotent"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "risk": {"enum": ["read", "bounded", "privileged", "destructive"]},
        "confirmation": {"enum": ["none", "explicit", "strong"]},
        "requiredScopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "available": {"type": "boolean"},
        "unavailableReason": {"type": "string", "maxLength": 500},
        "expiresAt": {"$ref": "#/$defs/timestamp"},
        "idempotent": {"type": "boolean"},
        "inputSchema": {"type": "object"},
        "nativeUrl": {"type": "string", "format": "uri"}
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "providerId", "kind", "title", "summary", "lifecycle", "phase", "attention", "health", "providerState", "revision", "dependencyIds", "actions", "updatedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "providerId": {"$ref": "#/$defs/id"},
        "workspaceId": {"$ref": "#/$defs/id"},
        "parentId": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["initiative", "task"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "summary": {"type": "string", "maxLength": 2000},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "phase": {"$ref": "#/$defs/phase"},
        "attention": {"$ref": "#/$defs/attentionLevel"},
        "health": {"$ref": "#/$defs/health"},
        "providerState": {"type": "string", "minLength": 1, "maxLength": 160},
        "revision": {"type": "string", "minLength": 1, "maxLength": 200},
        "dependencyIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "nativeUrl": {"type": "string", "format": "uri"},
        "updatedAt": {"$ref": "#/$defs/timestamp"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "providerId", "kind", "name", "health", "status", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "providerId": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["human", "agent", "worker", "verifier", "service"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "health": {"$ref": "#/$defs/health"},
        "status": {"type": "string", "minLength": 1, "maxLength": 120},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "updatedAt": {"$ref": "#/$defs/timestamp"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "providerId", "taskId", "sequence", "lifecycle", "phase", "actorIds", "startedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "providerId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "phase": {"$ref": "#/$defs/phase"},
        "actorIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "summary": {"type": "string", "maxLength": 2000},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "providerId", "attemptId", "kind", "name", "mediaType", "createdAt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "providerId": {"$ref": "#/$defs/id"},
        "attemptId": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["change_set", "file", "build", "report", "model", "dataset", "preview", "other"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 160},
        "digest": {"type": "string", "maxLength": 200},
        "uri": {"type": "string", "format": "uri"},
        "createdAt": {"$ref": "#/$defs/timestamp"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "providerId", "attemptId", "kind", "outcome", "summary", "recordedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "providerId": {"$ref": "#/$defs/id"},
        "attemptId": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["test", "evaluation", "review", "measurement", "attestation", "other"]},
        "outcome": {"enum": ["passed", "failed", "warning", "unknown"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "recordedAt": {"$ref": "#/$defs/timestamp"},
        "artifactIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "attentionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "providerId", "subject", "level", "reason", "message", "createdAt", "actions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "providerId": {"$ref": "#/$defs/id"},
        "subject": {"$ref": "#/$defs/reference"},
        "level": {"$ref": "#/$defs/attentionLevel"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 160},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000},
        "createdAt": {"$ref": "#/$defs/timestamp"},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    }
  }
}
