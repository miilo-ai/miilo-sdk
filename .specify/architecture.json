{
  "layers": [
    {
      "name": "telemetry-core",
      "paths": ["rust/src/telemetry/domain.rs", "rust/src/telemetry/mapping.rs"],
      "forbid": ["\\b(?:opentelemetry|opentelemetry_sdk|axum|reqwest|sqlx|tokio)::", "std::(?:fs|net|process|thread)", "\\bSystemTime\\b", "Utc::now\\(", "std::env", "super::otel"]
    },
    {
      "name": "runtime",
      "paths": [
        "rust/src/runtime/**/*.rs"
      ],
      "forbid": [
        "\\b(?:axum|reqwest|sqlx|notify|tempfile)::",
        "std::(?:fs|net|process|thread)",
        "\\bSystemTime\\b",
        "Utc::now\\(",
        "crate::(?:adapters|config|engine|transport)::",
        "\\buse\\s+super::\\*",
        "\\b(?:fs|env|process|thread)::",
        "Uuid::new_v4\\(",
        "Instant::now\\("
      ]
    }
  ],
  "existingSizeExceptions": {}
}
